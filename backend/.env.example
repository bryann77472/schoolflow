# Copie este arquivo para .env e preencha com os seus valores reais.
# NUNCA comite o arquivo .env nem credenciais no GitHub/frontend.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# URL de conexão do PostgreSQL (local ou Render). Exemplo de formato:
# postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public

# Chave secreta para assinar os JWTs (mínimo 32 caracteres).
# Gere uma chave aleatória, por exemplo: openssl rand -base64 48
JWT_SECRET=substitua-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d

# Origens permitidas pelo CORS (separadas por vírgulas).
# Inclua a URL do Static Site em produção. Nunca use *.
CORS_ORIGIN=http://localhost:4173,http://localhost:3000

# Cookies de sessão:
# - COOKIE_SECURE=true é obrigatório em produção (forçado pelo código).
# - COOKIE_SAME_SITE=none é necessário quando frontend e backend estão em
#   subdomínios diferentes do Render (onrender.com está na Public Suffix List,
#   então a requisição é cross-site). Em produção o padrão já é none.
# - Em desenvolvimento, o padrão é lax.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

LOG_LEVEL=info
